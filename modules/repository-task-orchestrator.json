{
  "abi": 11,
  "module": "quartz.repository-task.orchestrator",
  "version": "0.1.0",
  "execution_mode": "wasm-component",
  "requested_host_capabilities": [
    "event-count",
    "event-payload-byte",
    "event-payload-len",
    "event-output-write",
    "read-event",
    "read-snapshot",
    "resume-event-output",
    "resume-snapshot"
  ],
  "component": {
    "id": "repository-task-orchestrator",
    "config_schema": "u64",
    "max_activation_steps": 1,
    "inject": [
      {
        "slot": 4,
        "kind": "callable",
        "namespace": "quartz.events",
        "interface": "stream",
        "min_revision": 1,
        "max_revision": 1
      }
    ],
    "provide": []
  }
}
