{
  "abi": 10,
  "module": "quartz.slice4.agent-loop",
  "version": "0.1.0",
  "execution_mode": "wasm-component",
  "requested_host_capabilities": [
    "event-count",
    "invoke",
    "publish",
    "read-event",
    "resume-event",
    "resume-exchange",
    "set-state"
  ],
  "component": {
    "id": "agent-loop",
    "config_schema": "u64",
    "max_activation_steps": 1,
    "inject": [
      {
        "slot": 4,
        "kind": "callable",
        "namespace": "quartz.events",
        "interface": "stream",
        "min_revision": 1,
        "max_revision": 1
      },
      {
        "slot": 10,
        "kind": "callable",
        "namespace": "quartz.agent",
        "interface": "provider",
        "min_revision": 1,
        "max_revision": 1
      },
      {
        "slot": 11,
        "kind": "callable",
        "namespace": "quartz.agent",
        "interface": "repository-read",
        "min_revision": 1,
        "max_revision": 1
      }
    ],
    "provide": [
      {
        "slot": 13,
        "kind": "value",
        "namespace": "quartz.agent",
        "interface": "turn-state",
        "revision": 1
      }
    ]
  }
}
