package quartz:component@0.7.0;

world module {
  /// Set a fiber-owned context cell. Returns zero or a Quartz status code.
  import set-state: func(key: u64, value: u64) -> s32;

  /// Publish one declared coeffect slot. Returns zero or a Quartz status code.
  import publish: func(slot: u64, value: u64) -> s32;

  /// Resolve one declared coeffect slot through the committed provider view.
  /// Non-negative values are coeffect values; negative values are Quartz status codes.
  import resolve: func(slot: u64) -> s64;

  /// Publish one declared callable coeffect slot.
  import publish-callable: func(slot: u64) -> s32;

  /// Invoke one callable slot through the committed provider view.
  import call-provider: func(slot: u64, operation: u64, arg0: u64, arg1: u64) -> s64;

  /// Apply one host-admitted patch after callable authority approval.
  import apply-patch: func(index: u64, base-revision: u64) -> s32;

  /// Register one child from the committed declarative child list.
  import register-child: func(index: u32) -> s32;

  /// Register one host-admitted composition journal path.
  import open-journal: func(index: u64) -> s32;

  /// Register one host-admitted durable event-stream path.
  import open-event-stream: func(index: u64) -> s32;

  /// Queue one host-admitted typed value in 0..=s64::MAX until activation commits.
  import append-event: func(index: u64, value: u64) -> s32;

  /// Queue one host-admitted typed value after replay-aware event projection.
  import resume-event: func(index: u64, value: u64) -> s32;

  /// Return one admitted immutable snapshot length, or a negative Quartz status.
  import snapshot-len: func(index: u64) -> s64;

  /// Return one admitted immutable snapshot byte, or a negative Quartz status.
  import snapshot-byte: func(index: u64, offset: u64) -> s32;

  /// Queue one replay-aware event with an admitted immutable snapshot payload.
  import resume-snapshot: func(event-index: u64, snapshot-index: u64, value: u64) -> s32;

  /// Register one component-owned, host-admitted bounded exchange ledger.
  import open-exchange: func(index: u64) -> s32;

  /// Run or reconstruct one stable exchange from a committed event payload.
  /// Non-negative values are usage; negative values are Quartz status codes.
  import exchange: func(event-index: u64, invocation: u64) -> s64;

  /// Queue the staged callable response as a replay-aware durable payload.
  import resume-exchange: func(event-index: u64, value: u64) -> s32;
  /// Return the bounded committed event count, or a negative Quartz status.
  import event-count: func() -> s64;

  /// Read one non-negative committed event value, or a negative Quartz status.
  import read-event: func(index: u64) -> s64;

  /// Create activation-local state. This call must not mutate the context.
  export start: func(config: u64) -> u64;

  /// Run one atomic activation iteration: zero continues, one completes, and a
  /// negative Quartz status fails activation.
  export step: func(instance: u64) -> s32;

  /// Handle one synchronous callable-coeffect request without host reentry.
  export invoke: func(instance: u64, operation: u64, arg0: u64, arg1: u64) -> s64;

  /// Release activation-local guest state after all effects recover.
  export drop: func(instance: u64);
}
